<?xml version="1.0" encoding="utf-8"?>
<!--
    Downloaded episodes would blow the 25 MB cloud-backup quota, and over quota
    Android backs up nothing at all — not even subscriptions. A missing file after
    a restore is forgotten on launch (PodcastRepository.reconcileDownloads).

    The database holds feed addresses, and a private feed's address is its password,
    so it only goes to the cloud when the backup is end-to-end encrypted (the phone
    has a screen lock).
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="downloads" />
    </cloud-backup>
</data-extraction-rules>
